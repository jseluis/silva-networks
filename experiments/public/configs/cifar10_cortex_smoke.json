{
  "name": "cifar10_cortex_smoke",
  "kind": "torchvision_image_classification",
  "dataset": "CIFAR10",
  "data_root": "data",
  "download": true,
  "train": true,
  "max_samples": 24,
  "preset": "cortex",
  "hidden_dim": [16, 12],
  "classes": 10,
  "attention_mode": "simple",
  "graph_mode": "GAT",
  "k_neighbors": 4,
  "num_heads": 2,
  "alphas": [0.5, 0.2],
  "max_iter": 2,
  "internal_depth": 1,
  "self_interaction": true,
  "steps": 1,
  "lr": 0.005,
  "device": "auto"
}
